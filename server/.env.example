# InstaPulse AI Backend Environment Configuration

# Server Port
PORT=5000

# Meta / Instagram Graph API Credentials (100% Free)
# Get your User Access Token from https://developers.facebook.com/
META_ACCESS_TOKEN=your_meta_user_access_token_here

# Instagram Business or Creator Account ID
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000

# Optional Meta App Credentials for OAuth login
META_APP_ID=123456789012345
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback
